{
  "name": "office-ai",
  "version": "0.1.0",
  "private": true,
  "description": "officeAI — AI-native, browser-embeddable editors for DOCX (XLSX/PPTX deferred)",
  "scripts": {
    "predev": "lsof -ti :3000 | xargs kill -9 2>/dev/null; true",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:root": "eslint \"packages/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo run test -- --coverage",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "architecture": "node scripts/check-architecture.mjs",
    "verify": "pnpm format:check && pnpm lint:root && pnpm --filter @officeai/web lint && pnpm architecture && pnpm typecheck && pnpm test && pnpm build",
    "fixtures:docx": "node scripts/generate-docx-fixtures.mjs",
    "fixtures:pptx": "node scripts/generate-pptx-fixtures.mjs",
    "fixtures:pptx-real": "node scripts/generate-real-pptx-fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "docx": "^9.1.0",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
