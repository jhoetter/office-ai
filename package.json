{
  "name": "office-ai",
  "version": "0.1.10",
  "private": true,
  "description": "office-ai — MCP-first document engine and web editor for DOCX, XLSX, PPTX and PDF",
  "scripts": {
    "predev": "lsof -ti :3000 | xargs kill -9 2>/dev/null; true",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:root": "eslint \"packages/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo run test -- --coverage",
    "clean": "turbo clean && rm -rf node_modules",
    "smoke:local-install": "pnpm --filter @officeai/agent build && pnpm --filter @officeai/web build && node scripts/local-install-smoke.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "architecture": "node scripts/check-architecture.mjs",
    "actions": "node scripts/check-action-parity.mjs",
    "scorecard": "node scripts/generate-surface-scorecard.mjs",
    "scorecard:check": "node scripts/generate-surface-scorecard.mjs --check",
    "fixtures:check": "node scripts/check-fixture-matrix.mjs",
    "roundtrip:gate": "node scripts/roundtrip-gate.mjs --include-negative-self-test",
    "verify": "pnpm format:check && pnpm lint:root && pnpm --filter @officeai/web lint && pnpm actions && pnpm scorecard:check && pnpm fixtures:check && pnpm architecture && pnpm typecheck && pnpm test && pnpm build && pnpm roundtrip:gate && pnpm bundle:dry-run",
    "bundle:dry-run": "node scripts/bundle-dry-run.mjs",
    "fixtures:docx": "node scripts/generate-docx-fixtures.mjs",
    "fixtures:xlsx": "node scripts/generate-xlsx-fixtures.mjs",
    "fixtures:pptx": "node scripts/generate-pptx-fixtures.mjs",
    "fixtures:pptx-real": "node scripts/generate-real-pptx-fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.2",
    "@typescript-eslint/parser": "^8.58.2",
    "docx": "^9.1.0",
    "eslint": "^9",
    "eslint-plugin-import": "^2.32.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5",
    "@e965/xlsx": "^0.20.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
