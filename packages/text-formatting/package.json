{
  "name": "@officeai/text-formatting",
  "version": "0.1.9",
  "description": "Format-agnostic text-formatting contract: TextFormat, units, MIXED-state, and provider interface shared by DOCX, XLSX, and PPTX.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs && pnpm run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "esbuild": "^0.24",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhoetter/office-ai.git",
    "directory": "packages/text-formatting"
  },
  "homepage": "https://github.com/jhoetter/office-ai",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
