{
  "name": "@officeai/agent",
  "version": "0.1.10",
  "description": "office-agent CLI + programmatic API. DOCX, XLSX and PPTX wired through the same headless agents.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "office-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "sandbox/Dockerfile",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@officeai/core": "workspace:*",
    "@officeai/docx": "workspace:*",
    "@officeai/pdf": "workspace:*",
    "@officeai/pdf-annotations": "workspace:*",
    "@officeai/pdf-edit": "workspace:*",
    "@officeai/pdf-forms": "workspace:*",
    "@officeai/pdf-ocr": "workspace:*",
    "@officeai/pptx": "workspace:*",
    "@officeai/xlsx": "workspace:*",
    "commander": "^12.1.0",
    "ws": "^8.18.0",
    "y-websocket": "^2.0.4",
    "yjs": "^13.6.20",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.5.13",
    "docx": "^9.1.0",
    "jszip": "^3.10.1",
    "lib0": "^0.2.117",
    "pdf-lib": "^1.17.1",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "y-protocols": "^1.0.6"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhoetter/office-ai.git",
    "directory": "packages/agent"
  },
  "homepage": "https://github.com/jhoetter/office-ai",
  "publishConfig": {
    "access": "public"
  }
}
