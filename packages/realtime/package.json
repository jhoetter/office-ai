{
  "name": "@officeai/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime collaboration substrate: Yjs-backed room client, command-log codec, awareness types (presence + cursors). Headless and React-free.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@officeai/core": "workspace:^",
    "yjs": "^13.6.20",
    "y-protocols": "^1.0.6"
  },
  "peerDependencies": {
    "y-websocket": "^2.0.4"
  },
  "peerDependenciesMeta": {
    "y-websocket": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^2.1.9",
    "y-websocket": "^2.0.4"
  }
}
