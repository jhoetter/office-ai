{
  "name": "@officeai/xlsx",
  "version": "0.1.8",
  "description": "XLSX editor: parser, model, serializer, formula engine, command handlers, agent API, virtualized renderer.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./formula": {
      "types": "./dist/formula/index.d.ts",
      "import": "./dist/formula/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@officeai/core": "workspace:*",
    "fast-xml-parser": "^4.5.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhoetter/office-ai.git",
    "directory": "packages/xlsx"
  },
  "homepage": "https://github.com/jhoetter/office-ai",
  "publishConfig": {
    "access": "public"
  }
}
