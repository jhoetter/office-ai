{
  "name": "@officeai/pptx",
  "version": "0.1.0",
  "private": true,
  "description": "PPTX editor: parser, model, serializer, command handlers, agent API, hybrid SVG/HTML renderer.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./renderer/react": {
      "types": "./dist/renderer/react/index.d.ts",
      "import": "./dist/renderer/react/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@officeai/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "jszip": "^3.10.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
