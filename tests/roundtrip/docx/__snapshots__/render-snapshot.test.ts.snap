exports[`DOCX renderer snapshots > 10-landscape-section.docx: doc-to-pm projection is stable 1`] = `
{
  "content": [
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2",
        "propsJson": "{"styleId":"Heading1"}",
        "styleId": "Heading1",
      },
      "content": [
