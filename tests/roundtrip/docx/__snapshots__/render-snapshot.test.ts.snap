          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-941",
        "propsJson": "{"styleId":"Verzeichnis1","opaqueProps":[{"tag":"w:tabs","attrs":{},"subtree":[{"w:tab":[],":@":{"@_w:val":"right","@_w:leader":"dot","@_w:pos":"9016"}}],"rawAttrs":{}},{"tag":"w:rPr","attrs":{},"subtree":[{"w:noProof":[]}],"rawAttrs":{}}]}",
        "styleId": "Verzeichnis1",
      },
      "content": [
        {
          "marks": [
