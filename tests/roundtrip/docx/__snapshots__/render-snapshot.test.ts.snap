widthTw":2256,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Guided Analysis","fontSize":18}]}],"props":{"shadingFill":"FFFFFF","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":2257,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Aktiver Analyst","fontSize":18}]}],"props":{"shadingFill":"FFFFFF","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":2257,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Datensammlung + Strukturierung","fontSize":18}]}],"props":{"shadingFill":"FFFFFF","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":2256,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}}]},{"header":false,"cells":[{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"D: Schwer/Schwer","bold":true,"fontSize":18}]}],"props":{"shadingFill":"F5F5F5","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":2256,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Structured Co-Creation","fontSize":18}]}],"props":{"shadingFill":"FFFFFF","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":2257,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Co-Creator","fontSize":18}]}],"props":{"shadingFill":"FFFFFF","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":2257,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Unterstützer + Sparring-Partner","fontSize":18}]}],"props":{"shadingFill":"FFFFFF","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":2256,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}}]}],"gridCols":[2256,2257,2257,2256],"props":{"borders":{"top":{"style":"single","size":4,"color":"auto"},"left":{"style":"single","size":4,"color":"auto"},"bottom":{"style":"single","size":4,"color":"auto"},"right":{"style":"single","size":4,"color":"auto"},"insideH":{"style":"single","size":4,"color":"auto"},"insideV":{"style":"single","size":4,"color":"auto"}},"padRight":10,"padLeft":10,"widthType":"dxa","widthTw":9026}}",
      },
      "type": "table",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2234",
        "propsJson": "{}",
        "styleId": null,
      },
      "content": [
        {
          "attrs": {
            "breakType": "page",
          },
          "type": "hard_break",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2240",
        "propsJson": "{"styleId":"berschrift1"}",
        "styleId": "berschrift1",
      },
      "content": [
        {
          "text": "7  Diskussion & weiterführende Implikationen",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2241",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2246",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "7.1  Verschiebung des Tätigkeitsprofils",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2253",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Eine zentrale Implikation der Ergebnisse betrifft die ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Verschiebung des Tätigkeitsprofils",
          "type": "text",
        },
        {
          "text": " im Enterprise SaaS Vertrieb. Wenn KI die Aufgaben in Quadrant A und B zunehmend übernimmt oder zumindest die Generierungsarbeit leistet, dann verschieben sich die menschlichen Tätigkeiten unweigerlich in Richtung der Quadranten C und D.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2256",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Konkret bedeutet das: Wenn Security Questionnaires, NDA Reviews und Support-Tickets weitgehend von KI erledigt werden, wird der Mensch sich stärker auf jene Aufgaben konzentrieren müssen, die schwer zu verifizieren sind – ROI-Argumentation, strategische Planung, Beziehungsmanagement. Die Rolle verschiebt sich vom Ausführenden zum Strategen und Analysten.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2257",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2262",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "7.2  Human-in-the-Loop vs. AI-in-the-Loop",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2265",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Die Ergebnisse werfen eine provozierende Frage auf: Bis zu welchem Grad ist ein Human-in-the-Loop bei Use Cases mit einfacher Verifikation überhaupt sinnvoll?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2268",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Bei Security Questionnaires beispielsweise könnte perspektivisch die KI nicht nur die Antworten generieren, sondern auch die Verifikation übernehmen – etwa durch Kreuzvalidierung gegen mehrere unabhängige Quellen. Der Mensch wäre dann nicht mehr der Verifikator, sondern die KI würde eine Art AI-in-the-Loop für eine andere KI darstellen.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2271",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Gleichzeitig gibt es gute Gründe, den Menschen im Loop zu behalten: Verantwortlichkeit, Vertrauen des Kunden, regulatorische Anforderungen, und die Tatsache, dass KI-Systeme immer noch Halluzinationen produzieren können.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2272",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2277",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "7.3  Agentic Business Process Management",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2288",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Enterprise SaaS Sales ist ein hochgradig ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "kommunikationsintensiver Prozess",
          "type": "text",
        },
        {
          "text": ". E-Mails, Slack-Nachrichten, Meeting-Notizen – die Kommunikation zwischen Vertrieb, Kunde und internem Team bildet das Rückgrat des gesamten Sales-Prozesses. Hier knüpft das Konzept des ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Agentic BPM",
          "type": "text",
        },
        {
          "text": " an.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2292",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Agentic BPM beschreibt die Idee, dass KI-Agenten eigenständig Geschäftsprozesse orchestrieren können – Aufgaben delegieren, Status tracken, Eskalationen auslösen. Die in dieser Arbeit identifizierten Design Patterns können als Bausteine für ein solches agentic BPM-System dienen:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2295",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Das Notification-Inbox-Pattern für schnelle Review-Workflows",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2298",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Das Guided-Analysis-Pattern für komplexe Validierungsprozesse",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2301",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Team-Assignment-Logik für automatisiertes Routing",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2302",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2307",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "7.4  Guardrails & Vertrauen",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2310",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Eine weitere Implikation betrifft die Gestaltung von Guardrails – also Leitplanken, die sicherstellen, dass KI-generierte Ergebnisse bestimmte Qualitätsstandards erfüllen. Die Verifikationsschwierigkeit eines Use Cases hat direkte Implikationen für die Art der benötigten Guardrails:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2315",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Quadrant A/B (leicht zu verifizieren): ",
          "type": "text",
        },
        {
          "text": "Automatisierte Guardrails möglich (z.B. regelbasierte Checks, Unit-Test-ähnliche Validierung)",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2320",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Quadrant C/D (schwer zu verifizieren): ",
          "type": "text",
        },
        {
          "text": "Menschliche Guardrails erforderlich, ggf. ergänzt durch Confidence Scores und Unsicherheitsanzeigen",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2321",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2326",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "7.5  Wertschöpfungsketten und Kaskadeneffekte",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2329",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Wenn bestimmte Aufgaben durch KI effizienter werden, hat das Kaskadeneffekte auf die gesamte Wertschöpfungskette im Vertrieb. Schnellere Security Questionnaires bedeuten schnellere Deal-Zyklen. Schnellere NDA-Approvals bedeuten früheren Zugang zu technischen Evaluierungen. Diese Beschleunigungen verändern nicht nur einzelne Aufgaben, sondern den gesamten Rhythmus und die Dynamik des Enterprise Sales-Prozesses.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2332",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Gleichzeitig können neue Bottlenecks entstehen: Wenn die „leichten“ Aufgaben schneller werden, werden die „schweren“ Aufgaben (ROI-Validierung, strategische Entscheidungen) zum neuen kritischen Pfad.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2335",
        "propsJson": "{}",
        "styleId": null,
      },
      "content": [
        {
          "attrs": {
            "breakType": "page",
          },
          "type": "hard_break",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2341",
        "propsJson": "{"styleId":"berschrift1"}",
        "styleId": "berschrift1",
      },
      "content": [
        {
          "text": "8  Fazit & Ausblick",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2342",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2345",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Diese Arbeit hat gezeigt, dass Jason Weis Konzept der Verifikationsasymmetrie ein wertvolles analytisches Werkzeug für die Analyse und Gestaltung von Human-AI-Interfaces in komplexen Arbeitsdomänen ist. Am Beispiel des Enterprise SaaS Vertriebs wurde demonstriert, wie sich verschiedene Use Cases systematisch in einen Verifikationsquadranten einordnen lassen und wie daraus konkrete, quadrantenspezifische Design Patterns abgeleitet werden können.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2346",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2349",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Zentrale Ergebnisse:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2352",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Der Verifikationsquadrant eignet sich als praktisches Framework zur Analyse und Strukturierung von Aufgaben im Enterprise SaaS Vertrieb",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2355",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Vier Design Patterns wurden identifiziert: Notification Inbox (B), Guided Analysis (C), Auto-Execute (A) und Structured Co-Creation (D)",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2358",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Die Position eines Use Cases im Quadranten hat direkte Implikationen für Interface-Design, Rolle des Menschen und Art der Guardrails",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2361",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Der methodische Ansatz (DSR mit Echelons auf zwei Ebenen) hat sich als geeignet erwiesen, um sowohl tiefe Use-Case-Erkenntnisse als auch übergreifende Patterns zu gewinnen",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2362",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2365",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Ausblick:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2368",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Die Arbeit eröffnet mehrere Anschlussmöglichkeiten: Die Übertragung des Frameworks auf andere Domänen (z.B. Consulting, Rechtswesen, Healthcare), die empirische Validierung der Design Patterns in größerem Maßstab, und die Integration in agentic BPM-Systeme. Besonders spannend ist die Frage, wie sich der Quadrant selbst über Zeit verändert – wenn KI besser wird, verschieben sich Use Cases potenziell in Richtung leichterer Verifikation, was wiederum neue Interface-Paradigmen ermöglicht.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2371",
        "propsJson": "{}",
        "styleId": null,
      },
      "content": [
        {
          "attrs": {
            "breakType": "page",
          },
          "type": "hard_break",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2377",
        "propsJson": "{"styleId":"berschrift1"}",
        "styleId": "berschrift1",
      },
      "content": [
        {
          "text": "Anhang: Strategie für die Verteidigung",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2378",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2385",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Für die Verteidigung der Thesis wird empfohlen, die Präsentation ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "„von hinten aufzuziehen“",
          "type": "text",
        },
        {
          "text": " – also mit dem Ergebnis zu starten und dann den Weg dorthin zu erklären.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2386",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2391",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "Vorgeschlagener Aufbau der Präsentation (ca. 20-25 Min.)",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2392",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2397",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Eröffnung (2 Min.): ",
          "type": "text",
        },
        {
          "text": "Den gefüllten Quadranten zeigen. „Das ist das Ergebnis meiner Arbeit. Lassen Sie mich erklären, wie ich hier hingekommen bin und was das bedeutet.“",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2402",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Das Problem (3 Min.): ",
          "type": "text",
        },
        {
          "text": "Weis Verification Rule einführen. Sudoku-Beispiel. Warum ist das für die Praxis relevant?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2407",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Die Domäne (3 Min.): ",
          "type": "text",
        },
        {
          "text": "Enterprise SaaS Sales kurz erklären. Die drei Töpfe zeigen. Warum ist dieser Bereich ein ideales Anwendungsfeld?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2412",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Die Methodik (3 Min.): ",
          "type": "text",
        },
        {
          "text": "DSR mit Echelons erklären. Zwei-Ebenen-Ansatz visualisieren.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2417",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Der Weg zum Ergebnis (5-7 Min.): ",
          "type": "text",
        },
        {
          "text": "Ausgewählte Echelons zeigen. Den Quadranten schrittweise aufbauen. Kontrast zwischen Security Questionnaire (leicht zu verifizieren) und ROI-Case (schwer zu verifizieren).",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2422",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Die Design Patterns (3-4 Min.): ",
          "type": "text",
        },
        {
          "text": "Die vier Patterns vorstellen. Mockup-Screenshots zeigen. Gegenüberstellung Notification Inbox vs. Guided Analysis.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2427",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Diskussion & Implikationen (3-4 Min.): ",
          "type": "text",
        },
        {
          "text": "Task Shifting, Human-in-the-Loop vs. AI-in-the-Loop, Agentic BPM. Der Bogen zum großen Ganzen.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2432",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Abschluss (1 Min.): ",
          "type": "text",
        },
        {
          "text": "Zurück zum gefüllten Quadranten. Was haben wir gelernt? Was kommt als Nächstes?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2433",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-2438",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Kern-Narrative der Verteidigung: ",
          "type": "text",
        },
        {
          "text": "„Die Schwierigkeit der Verifikation bestimmt, wie das Interface zwischen Mensch und KI gestaltet sein muss. Ich habe das am Beispiel Enterprise SaaS Sales untersucht, iterativ Design Patterns entwickelt und zeige, welche fundamentalen Implikationen sich daraus für die Zukunft wissensintensiver Arbeit ergeben.“",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "blockId": "n-2439",
        "rawJson": "{"tag":"w:sectPr","attrs":{"w:rsidR":"00DB779B"},"subtree":[{"w:headerReference":[],":@":{"@_w:type":"default","@_r:id":"rId7"}},{"w:footerReference":[],":@":{"@_w:type":"default","@_r:id":"rId8"}},{"w:pgSz":[],":@":{"@_w:w":"11906","@_w:h":"16838"}},{"w:pgMar":[],":@":{"@_w:top":"1440","@_w:right":"1440","@_w:bottom":"1440","@_w:left":"1440","@_w:header":"708","@_w:footer":"708","@_w:gutter":"0"}},{"w:cols":[],":@":{"@_w:space":"720"}},{"w:docGrid":[],":@":{"@_w:linePitch":"360"}}],"rawAttrs":{"@_w:rsidR":"00DB779B"}}",
      },
      "type": "section_break",
    },
  ],
  "type": "doc",
}
`;

