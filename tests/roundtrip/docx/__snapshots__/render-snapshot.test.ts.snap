        "tableJson": "{"rows":[{"header":false,"cells":[{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Use-Case-Ebene","bold":true,"fontSize":22,"color":"FFFFFF"}],"alignment":"center"}],"props":{"shadingFill":"2E75B6","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":4513,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Quadranten-Ebene","bold":true,"fontSize":22,"color":"FFFFFF"}],"alignment":"center"}],"props":{"shadingFill":"1B3A5C","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":4513,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}}]},{"header":false,"cells":[{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Einzelne Use Cases werden in eigenen Echelons untersucht:","fontSize":20}]},{"kind":"paragraph","runs":[{"text":"• Security Questionnaire bearbeiten","fontSize":18}]},{"kind":"paragraph","runs":[{"text":"• NDA prüfen und freigeben","fontSize":18}]},{"kind":"paragraph","runs":[{"text":"• ROI-Case aufbauen","fontSize":18}]},{"kind":"paragraph","runs":[{"text":"• Support-Tickets lösen","fontSize":18}]},{"kind":"paragraph","runs":[{"text":"• Org-Struktur analysieren","fontSize":18}]}],"props":{"shadingFill":"D5E8F0","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":4513,"padTop":120,"padRight":160,"padBottom":120,"padLeft":160}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragr