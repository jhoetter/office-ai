                "relationshipId": null,
              },
              "type": "hyperlink",
            },
          ],
          "text": "Anhang: Strategie für die Verteidigung",
          "type": "text",
        },
        {
          "marks": [
            {
              "attrs": {
                "anchor": "_Toc222756214",
                "hyperlinkId": "n-940",
                "relationshipId": null,
              },
              "type": "hyperlink",
            },
          ],
          "type": "tab",
        },
        {
          "marks": [
            {
              "attrs": {
                "anchor": "_Toc222756214",
                "hyperlinkId": "n-940",
                "relationshipId": null,
              },
              "type": "hyperlink",
            },
          ],
          "text": "26",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-962",
        "propsJson": "{"styleId":"Verzeichnis2","opaqueProps":[{"tag":"w:tabs","attrs":{},"subtree":[{"w:tab":[],":@":{"@_w:val":"right","@_w:leader":"dot","@_w:pos":"9016"}}],"rawAttrs":{}},{"tag":"w:rPr","attrs":{},"subtree":[{"w:noProof":[]}],"rawAttrs":{}}]}",
        "styleId": "Verzeichnis2",
      },
      "content": [
        {
          "marks": [
            {
              "attrs": {
                "anchor": "_Toc222756215",
                "hyperlinkId": "n-961",
                "relationshipId": null,
              },
              "type": "hyperlink",
            },
          ],
          "text": "Vorgeschlagener Aufbau der Präsentation (ca. 20-25 Min.)",
          "type": "text",
        },
        {
          "marks": [
            {
              "attrs": {
                "anchor": "_Toc222756215",
                "hyperlinkId": "n-961",
                "relationshipId": null,
              },
              "type": "hyperlink",
            },
          ],
          "type": "tab",
        },
        {
          "marks": [
            {
              "attrs": {
                "anchor": "_Toc222756215",
                "hyperlinkId": "n-961",
                "relationshipId": null,
              },
              "type": "hyperlink",
            },
          ],
          "text": "26",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-965",
        "propsJson": "{}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "blockId": "n-966",
        "side": "end",
        "tag": "w:sdt",
        "wrapperId": "wrap-1",
      },
      "type": "wrapper_marker",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-969",
        "propsJson": "{}",
        "styleId": null,
      },
      "content": [
        {
          "attrs": {
            "breakType": "page",
          },
          "type": "hard_break",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-975",
        "propsJson": "{"styleId":"berschrift1"}",
        "styleId": "berschrift1",
      },
      "content": [
        {
          "text": "1  Einleitung & Motivation",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-976",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-987",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Die Leistungsfähigkeit moderner KI-Systeme, insbesondere Large Language Models (LLMs), hat in den vergangenen Jahren eine bemerkenswerte Dynamik entwickelt. Was einst als Zukunftsvision galt – die automatisierte Erstellung von Quellcode, die Beantwortung komplexer Fachfragen, die Analyse unstrukturierter Daten – ist heute bereits Realität. Doch während die Fähigkeit zur ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Generierung",
          "type": "text",
        },
        {
          "text": " von Lösungen rasant voranschreitet, bleibt eine fundamentale Frage oft unterbelichtet: Wie einfach oder schwierig ist es eigentlich, eine generierte Lösung zu ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "verifizieren",
          "type": "text",
        },
        {
          "text": "?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-990",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Diese Frage ist keineswegs trivial. Jason Wei, ein renommierter KI-Forscher, hat in seinem viel beachteten Blogpost diese Asymmetrie zwischen Generierung und Verifikation systematisch aufgearbeitet. Seine zentrale Beobachtung lautet: Nicht alle Aufgaben sind gleich. Bei manchen ist es schwer, eine Lösung zu finden, aber einfach zu prüfen, ob sie korrekt ist. Bei anderen verhält es sich genau umgekehrt – oder es ist beides schwierig.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1001",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Das vielleicht anschaulichste Beispiel ist das ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Sudoku",
          "type": "text",
        },
        {
          "text": ": Eine Lösung zu generieren erfordert systematisches Durchprobieren und logisches Denken – das ist schwer. Aber sobald eine Lösung vorliegt, kann jeder Mensch (oder jedes Programm) in Sekunden prüfen, ob alle Zeilen, Spalten und Blöcke korrekt gefüllt sind. Die Verifikation ist trivial. Am anderen Ende des Spektrums steht die ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Riemannsche Vermutung",
          "type": "text",
        },
        {
          "text": ": Hier ist sowohl die Generierung eines Beweises als auch dessen Verifikation extrem schwierig – seit über 150 Jahren unbewiesen.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1008",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Besonders spannend wird es bei Aufgaben, die ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "einfach zu behaupten, aber schwer zu verifizieren",
          "type": "text",
        },
        {
          "text": " sind. Wenn jemand sagt: „Wenn du nur noch Karotten und Kartoffeln isst, wirst du 100 Jahre alt“, dann ist die Behauptung in Sekunden aufgestellt – die Verifikation dauert hingegen Jahrzehnte und erfordert umfangreiche empirische Daten. Genau diese Asymmetrie ist für den Einsatz von KI in der Praxis hochrelevant.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1009",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1014",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "1.1  Warum Enterprise SaaS Sales?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1020",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Diese Arbeit nimmt einen sehr konkreten, praxisnahen Anwendungsfall unter die Lupe: den Enterprise Software-as-a-Service (SaaS) Vertrieb. Dieser Bereich wurde gewählt, weil er eine außergewöhnliche Bandbreite an Aufgabentypen vereint, die sich fundamental in ihrer Generierungs- und Verifikationsschwierigkeit unterscheiden.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1027",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Enterprise SaaS Sales – also der Verkauf hochpreisiger Software-Lösungen an Großunternehmen mit ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "sechsstelligen Average Contract Values",
          "type": "text",
        },
        {
          "text": " – ist ein Bereich, der sich grundlegend von Low-Value-Sales unterscheidet. Hier reicht keine Kreditkarte. Stattdessen sind die Prozesse geprägt von:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1032",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Hoher Komplexität: ",
          "type": "text",
        },
        {
          "text": "Mehrere Stakeholder, lange Entscheidungszyklen, komplexe Organisationsstrukturen",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1037",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Intensiver Kommunikation: ",
          "type": "text",
        },
        {
          "text": "Zwischen Vertrieb und Kunde, aber auch intern zwischen Vertrieb und Fachexperten (Security, Legal, Product)",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1042",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Vielfältigen Aufgabentypen: ",
          "type": "text",
        },
        {
          "text": "Von vertraglichen Themen über Mehrwert-Argumentation bis hin zu Customer-Success-Aufgaben",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1047",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Hohem Druck: ",
          "type": "text",
        },
        {
          "text": "Jeder Deal ist strategisch relevant, Fehler sind kostspielig",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1048",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1051",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Die zentrale Frage dieser Arbeit lautet daher:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1052",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": "center",
        "paragraphId": "n-1055",
        "propsJson": "{"spacing":{"before":200,"after":200},"alignment":"center","opaqueProps":[{"tag":"w:pBdr","attrs":{},"subtree":[{"w:top":[],":@":{"@_w:val":"single","@_w:sz":"2","@_w:space":"8","@_w:color":"2E75B6"}},{"w:left":[],":@":{"@_w:val":"single","@_w:sz":"2","@_w:space":"8","@_w:color":"2E75B6"}},{"w:bottom":[],":@":{"@_w:val":"single","@_w:sz":"2","@_w:space":"8","@_w:color":"2E75B6"}},{"w:right":[],":@":{"@_w:val":"single","@_w:sz":"2","@_w:space":"8","@_w:color":"2E75B6"}}],"rawAttrs":{}}]}",
        "styleId": null,
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
            {
              "type": "italic",
            },
            {
              "attrs": {
                "rgb": "1B3A5C",
              },
              "type": "color",
            },
          ],
          "text": "How might we apply the Verification Rule to a real-world application such as Enterprise SaaS Sales – and derive design patterns for human-AI interfaces based on where use cases fall in the verification quadrant?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1056",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1061",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "1.2  Zwei Dimensionen der Forschungsfrage",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1064",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Die How-Might-We-Question dieser Arbeit hat zwei ineinander verwobene Dimensionen:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1069",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Anwendung der Verification Rule: ",
          "type": "text",
        },
        {
          "text": "Wie lassen sich die verschiedenen Aufgaben im Enterprise SaaS Vertrieb systematisch in den Quadranten der Verifikationsasymmetrie einordnen? Was bedeutet das für die Frage, welche Aufgaben KI kurzfristig übernehmen kann – und wo der Mensch weiterhin essenziell bleibt?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1074",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Ableitung von Design Patterns: ",
          "type": "text",
        },
        {
          "text": "Lassen sich aus der Position eines Use Cases im Quadranten systematische Designmuster für Software-Interfaces ableiten? Gibt es wiederkehrende Muster, wie Interfaces für „leicht zu verifizieren“ vs. „schwer zu verifizieren“ aussehen sollten?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1075",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1079",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Diese Arbeit verbindet damit theoretische Grundlagen aus der KI-Forschung mit praktischer Designarbeit und liefert sowohl wissenschaftliche Erkenntnisse als auch unmittelbar anwendbare Gestaltungsprinzipien.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1082",
        "propsJson": "{}",
        "styleId": null,
      },
      "content": [
        {
          "attrs": {
            "breakType": "page",
          },
          "type": "hard_break",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1088",
        "propsJson": "{"styleId":"berschrift1"}",
        "styleId": "berschrift1",
      },
      "content": [
        {
          "text": "2  Theoretische Grundlagen & Related Work",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1089",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1094",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "2.1  The Asymmetry of Verification – Jason Wei",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1101",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Den konzeptionellen Ausgangspunkt dieser Arbeit bildet Jason Weis Arbeit zur ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Asymmetrie der Verifikation",
          "type": "text",
        },
        {
          "text": ". Wei argumentiert, dass die Schwierigkeit einer Aufgabe nicht eindimensional betrachtet werden kann. Stattdessen müssen zwei orthogonale Dimensionen unterschieden werden:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1106",
