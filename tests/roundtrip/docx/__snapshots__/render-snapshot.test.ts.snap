        "tableJson": "{"rows":[{"header":false,"cells":[{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Schwer zu generieren Leicht zu verifizieren","bold":true,"fontSize":20,"color":"1B3A5C"}],"alignment":"center"}],"props":{"shadingFill":"FFF3E0","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"vAlign":"center","widthTw":4680,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Schwer zu generieren Schwer zu verifizieren","bold":true,"fontSize":20,"color":"1B3A5C"}],"alignment":"center"}],"props":{"shadingFill":"FCE4EC","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"vAlign":"center","widthTw":4680,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}}]},{"header":false,"cells":[{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Quadrant B","bold":true,"fontSize":20,"color":"1B3A5C"}]},{"kind":"paragraph","runs":[{"text":"• Sudoku-Typ-Aufgaben","fontSize":18,"color":"666666"}]},{"kind":"paragraph","runs":[{"text":"• Security Questionnaires","fontSize":18,"color":"666666"}]},{"kind":"paragraph","runs":[{"text":"• NDA Review / Approval","fontSize":18,"color":"666666"}]},{"kind":"paragraph","runs":[{"text":"• Contract Redlining","fontSize":18,"color":"666666"}]},{"kind":"paragraph","runs":[{"text":"• Support-Ticket-Bearbeitung","fontSize":18,"color":"666666"}]}],"props":{"shadingFill":"FFF3E0","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":4680,"padTop":120,"padRight":160,"padBottom":120,"padLeft":160}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Quadrant D","bold":true,"fontSize":20,"color":"1B3A5C"}]},{"kind":"paragraph","runs":[{"text":"• Mathematische Beweise","fontSize":18,"color":"666666"}]},{"kind":"paragraph","runs":[{"text":"• ROI-Case-Erstellung","fontSize":18,"color":"666666"}]},{"kind":"paragraph","runs":[{"text":"• Langzeit-Kundenwertsteigerung","fontSize":18,"color":"666666"}]}],"props":{"shadingFill":"FCE4EC","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":4680,"padTop":120,"padRight":160,"padBottom":120,"padLeft":160}}]},{"header":false,"cells":[{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Quadrant A","bold":true,"fontSize":20,"color":"1B3A5C"}]},{"kind":"paragraph","runs":[{"text":"• Einfache Statusabfragen","fontSize":18,"color":"666666"}]},{"kind":"paragraph","runs":[{"text":"• Standard-E-Mail-Vorlagen","fontSize":18,"color":"666666"}]},{"kind":"paragraph","runs":[{"text":"• Meeting-Zusammenfassungen","fontSize":18,"color":"666666"}]}],"props":{"shadingFill":"E8F5E9","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":4680,"padTop":120,"padRight":160,"padBottom":120,"padLeft":160}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Quadrant C","bold":true,"fontSize":20,"color":"1B3A5C"}]},{"kind":"paragraph","runs":[{"text":"• Claim: Unser Produkt spart 30%","fontSize":18,"color":"666666"}]},{"kind":"paragraph","runs":[{"text":"• Prognosen & Forecasts","fontSize":18,"color":"666666"}]},{"kind":"paragraph","runs":[{"text":"• Org.-Struktur-Analyse","fontSize":18,"color":"666666"}]}],"props":{"shadingFill":"E3F2FD","borders":{"top":{"style":"single","size":1,"color":"CCCCCC"},"left":{"style":"single","size":1,"color":"CCCCCC"},"bottom":{"style":"single","size":1,"color":"CCCCCC"},"right":{"style":"single","size":1,"color":"CCCCCC"}},"widthTw":4680,"padTop":120,"padRight":160,"padBottom":120,"padLeft":160}}]},{"header":false,"cells":[{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Leicht zu generieren Leicht zu verifizieren","italic":true,"fontSize":18,"color":"666666"}],"alignment":"center"}],"props":{"widthTw":4680,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}},{"gridSpan":1,"vMerge":null,"blocks":[{"kind":"paragraph","runs":[{"text":"Leicht zu generieren Schwer zu verifizieren","italic":true,"fontSize":18,"color":"666666"}],"alignment":"center"}],"props":{"widthTw":4680,"padTop":80,"padRight":120,"padBottom":80,"padLeft":120}}]}],"gridCols":[4680,4680],"props":{"borders":{"top":{"style":"single","size":4,"color":"auto"},"left":{"style":"single","size":4,"color":"auto"},"bottom":{"style":"single","size":4,"color":"auto"},"right":{"style":"single","size":4,"color":"auto"},"insideH":{"style":"single","size":4,"color":"auto"},"insideV":{"style":"single","size":4,"color":"auto"}},"padRight":10,"padLeft":10,"widthType":"dxa","widthTw":9360}}",
      },
      "type": "table",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1196",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1205",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Weis zentrale These – die ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "„Verifiers Rule“",
          "type": "text",
        },
        {
          "text": " – besagt: KI wird besonders dort schnell Fortschritte machen, wo die Verifikation einfach ist. Der Grund ist fundamental: Wenn wir schnell prüfen können, ob eine generierte Lösung korrekt ist, können wir die KI effizient trainieren, iterieren und einsetzen. ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Die Qualität der Verifikation bestimmt die Qualität der Generierung.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1211",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Dieses Prinzip lässt sich auch auf menschliche Arbeitsprozesse übertragen: Aufgaben mit einfacher Verifikation eignen sich hervorragend für eine Mensch-Maschine-Arbeitsteilung, bei der die KI generiert und der Mensch verifiziert. Bei Aufgaben mit schwieriger Verifikation hingegen stellt sich die Frage, ob und wie ein menschlicher Reviewer überhaupt sinnvoll eingebunden werden kann.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1212",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1221",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Implikation für die Softwareentwicklung: ",
          "type": "text",
        },
        {
          "text": "Wei weist auch darauf hin, dass das Verhältnis veränderbar ist. In der Softwareentwicklung beispielsweise können Unit-Tests die Verifikation automatisieren – damit verschiebt sich eine Aufgabe im Quadranten. Dieser Gedanke ist für die vorliegende Arbeit zentral: Durch geschicktes Interface-Design und Automatisierungsgestaltung können wir die Verifikation erleichtern und damit die Einsatzfähigkeit von KI verbessern.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1222",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1227",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "2.2  Design Science Research (DSR)",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1238",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Als methodisches Fundament dient ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Design Science Research (DSR)",
          "type": "text",
        },
        {
          "text": " nach Hevner et al. DSR ist ein Forschungsparadigma, das sich von klassischer empirischer Forschung dadurch unterscheidet, dass es nicht nur Phänomene beschreibt und erklärt, sondern aktiv ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Artefakte",
          "type": "text",
        },
        {
          "text": " entwickelt – Software-Prototypen, Frameworks, Design Principles – und deren Wirksamkeit evaluiert.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1241",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "DSR eignet sich ideal für diese Arbeit, weil:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1244",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Es die iterative Entwicklung von Software-Artefakten wissenschaftlich rahmt",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1247",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Es die Verbindung von Theorie (Verification Rule) und Praxis (Interface-Design) ermöglicht",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1250",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Es explizit Evaluation als integralen Bestandteil vorsieht",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1253",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Es den praxisnahen Charakter der Forschungsfrage abbildet",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1254",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1259",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "2.3  DSR mit Echelons (Tuunanen et al.)",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1266",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Für die konkrete Durchführung wird eine Erweiterung von DSR verwendet: ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Design Science Research mit Echelons",
          "type": "text",
        },
        {
          "text": " nach Tuunanen et al. Ein Echelon ist dabei eine abgegrenzte, überschaubare Iteration von Forschung und Entwicklung, bestehend aus:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1271",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":5,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"5"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Exploration: ",
          "type": "text",
        },
        {
          "text": "Interviews, Literaturrecherche, Shadowing, eigene Erfahrungen",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1276",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":5,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"5"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Analyse & Strukturierung: ",
          "type": "text",
        },
        {
          "text": "Mindmaps, Requirements Engineering, Synthese der Erkenntnisse",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1282",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":5,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"5"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Hypothesenbildung: ",
          "type": "text",
        },
        {
          "text": "Erstellung von Mockups, Prototypen oder Software-Artefakten",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1287",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":5,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"5"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Evaluation: ",
          "type": "text",
        },
        {
          "text": "Testing, Interviews, Feedback, Einsatz in der Praxis",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1292",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":5,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"5"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Lernen & Iteration: ",
          "type": "text",
        },
        {
          "text": "Erkenntnisse extrahieren, Hypothesen anpassen, nächste Iteration starten",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1293",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1300",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Der entscheidende Vorteil gegenüber einem linearen Vorgehen: Echelons können auf ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "verschiedenen Abstraktionsebenen",
          "type": "text",
        },
        {
          "text": " stattfinden. In dieser Arbeit wird auf zwei Ebenen iteriert:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1305",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Use-Case-Ebene: ",
          "type": "text",
        },
        {
          "text": "Einzelne Use Cases (z.B. Security Questionnaires) werden in eigenen Echelons erforscht, prototypisch umgesetzt und evaluiert.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1310",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Quadranten-Ebene: ",
          "type": "text",
        },
        {
          "text": "Auf einer höheren Abstraktionsebene werden Gemeinsamkeiten zwischen Use Cases desselben Quadranten identifiziert und zu übergreifenden Design Patterns verdichtet.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1311",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1314",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Dieses Vorgehen ermöglicht es, sowohl in die Tiefe einzelner Use Cases zu gehen als auch das große Bild – den gefüllten Quadranten mit abgeleiteten Design Patterns – schrittweise zu entwickeln.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1315",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1320",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "2.4  Enterprise SaaS Sales – Domäne und Kontext",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1327",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Enterprise SaaS Sales bezeichnet den Vertrieb von Software-as-a-Service-Lösungen an Großunternehmen (Enterprises). Im Gegensatz zu Self-Service- oder SMB-Vertrieb zeichnet sich dieser Bereich durch ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "hohe Komplexität, lange Verkaufszyklen und viele Stakeholder",
          "type": "text",
        },
        {
          "text": " aus.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1330",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Relevante Literatur und Frameworks für diese Domäne:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1335",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "MEDDIC/MEDDICC: ",
          "type": "text",
        },
        {
          "text": "Framework zur Qualifizierung von Enterprise-Deals (Metrics, Economic Buyer, Decision Criteria, Decision Process, Identify Pain, Champion, Competition)",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1340",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "SPIN Selling (Rackham): ",
          "type": "text",
        },
        {
          "text": "Fragetechnik für komplexe Verkäufe (Situation, Problem, Implication, Need-Payoff)",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1345",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Challenger Sale (Dixon & Adamson): ",
          "type": "text",
        },
        {
          "text": "Ansatz, der den Vertriebler als Berater positioniert, der dem Kunden neue Perspektiven eröffnet",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1351",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Revenue Operations: ",
          "type": "text",
        },
        {
          "text": "Moderne Ansätze zur Integration von Sales, Marketing und Customer Success",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1352",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1357",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "2.5  Weitere relevante Forschungsfelder",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1360",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Die Arbeit berührt zudem mehrere angrenzende Forschungsfelder, die in der Diskussion aufgegriffen werden:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1365",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Agentic Business Process Management (BPM): ",
          "type": "text",
        },
        {
          "text": "Wie können KI-Agenten in kommunikationsintensive Geschäftsprozesse eingebunden werden?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1370",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Human-AI Collaboration: ",
          "type": "text",
        },
        {
          "text": "Wie gestaltet man die Zusammenarbeit zwischen Mensch und KI optimal? Wann ist ein Human-in-the-Loop sinnvoll – und wann wird er zum Bottleneck?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1375",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Guardrails & AI Safety: ",
          "type": "text",
        },
        {
          "text": "Wie können Leitplanken gestaltet werden, die Qualität sichern, ohne den Prozess unnötig zu verlangsamen?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1380",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Wertschöpfungsketten & Task Shifting: ",
          "type": "text",
        },
        {
          "text": "Wenn KI bestimmte Aufgaben übernimmt, wie verschiebt sich das Tätigkeitsprofil des Menschen?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1383",
        "propsJson": "{}",
        "styleId": null,
      },
      "content": [
        {
          "attrs": {
            "breakType": "page",
          },
          "type": "hard_break",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1389",
        "propsJson": "{"styleId":"berschrift1"}",
        "styleId": "berschrift1",
      },
      "content": [
        {
          "text": "3  Forschungsfrage & Zielsetzung",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1390",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1395",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "3.1  Die How-Might-We-Question",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1398",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Die zentrale Forschungsfrage dieser Arbeit wird als How-Might-We-Question formuliert, was den explorativen und gestaltenden Charakter der Arbeit unterstreicht:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1399",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": "center",
        "paragraphId": "n-1402",
        "propsJson": "{"spacing":{"before":200,"after":200},"alignment":"center","opaqueProps":[{"tag":"w:shd","attrs":{"w:val":"clear","w:color":"auto","w:fill":"D5E8F0"},"subtree":[],"rawAttrs":{"@_w:val":"clear","@_w:color":"auto","@_w:fill":"D5E8F0"}}]}",
        "styleId": null,
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
            {
              "attrs": {
                "halfPoints": 26,
              },
              "type": "font_size",
            },
            {
              "attrs": {
                "rgb": "1B3A5C",
              },
              "type": "color",
            },
          ],
          "text": "How might we apply the Verification Rule to Enterprise SaaS Sales",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": "center",
        "paragraphId": "n-1405",
        "propsJson": "{"spacing":{"after":200},"alignment":"center","opaqueProps":[{"tag":"w:shd","attrs":{"w:val":"clear","w:color":"auto","w:fill":"D5E8F0"},"subtree":[],"rawAttrs":{"@_w:val":"clear","@_w:color":"auto","@_w:fill":"D5E8F0"}}]}",
        "styleId": null,
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
            {
              "attrs": {
                "halfPoints": 26,
              },
              "type": "font_size",
            },
            {
              "attrs": {
                "rgb": "1B3A5C",
              },
              "type": "color",
            },
          ],
          "text": "and derive design patterns for human-AI interfaces?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1406",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1411",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "3.2  Erwartete Ergebnisse",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1414",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Die Arbeit zielt auf drei konkrete Ergebnisse ab:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1419",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Gefüllter Verifikationsquadrant: ",
          "type": "text",
        },
        {
          "text": "Eine systematische Einordnung der identifizierten Use Cases aus dem Enterprise SaaS Vertrieb in den Quadranten. Dieser Quadrant wird im Verlauf der Arbeit schrittweise aufgebaut – der Leser erlebt, wie sich das Bild durch die iterativen Forschungsschleifen vervollständigt.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1424",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Design Patterns pro Quadrant: ",
          "type": "text",
        },
        {
          "text": "Für jeden Quadranten (oder zumindest die am stärksten besetzten) werden Interface-Designmuster abgeleitet. Diese Patterns beschreiben, wie Software gestaltet sein sollte, um die jeweilige Kombination aus Generierungs- und Verifikationsschwierigkeit optimal zu unterstützen.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1429",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":3,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"3"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Implikationen & Diskussion: ",
          "type": "text",
        },
        {
          "text": "Einordnung der Ergebnisse in den breiteren Kontext von Human-AI Collaboration, Agentic BPM und die Zukunft der Vertriebsarbeit.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1432",
        "propsJson": "{}",
        "styleId": null,
      },
      "content": [
        {
          "attrs": {
            "breakType": "page",
          },
          "type": "hard_break",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1438",
        "propsJson": "{"styleId":"berschrift1"}",
        "styleId": "berschrift1",
      },
      "content": [
        {
          "text": "4  Methodisches Vorgehen",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1439",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1444",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "4.1  Überblick: DSR mit Echelons",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1451",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Das methodische Vorgehen folgt dem Rahmenwerk von ",
          "type": "text",
        },
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Design Science Research mit Echelons",
          "type": "text",
        },
        {
          "text": " (Tuunanen et al.), aufbauend auf den Grundprinzipien von Hevner et al. Der Forschungsprozess gliedert sich in mehrere aufeinander aufbauende Iterationsschleifen (Echelons), die auf zwei Abstraktionsebenen stattfinden.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1452",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1457",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Ausgangslage: ",
          "type": "text",
        },
        {
          "text": "Enterprise SaaS Vertrieb ist ein komplexes, kommunikationsintensives Tätigkeitsfeld mit heterogenen Aufgabentypen. Die Vermutung besteht, dass Jason Weis Verification Rule einen wertvollen analytischen Rahmen bietet, um diese Aufgaben systematisch zu strukturieren und daraus Designimplikationen abzuleiten.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1458",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1463",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "4.2  Forschungsprozess im Detail",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1464",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1469",
        "propsJson": "{"styleId":"berschrift3"}",
        "styleId": "berschrift3",
      },
      "content": [
        {
          "text": "Phase 1: Exploration & Problemverständnis",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1472",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "In der initialen Explorationsphase werden verschiedene Methoden kombiniert, um ein tiefes Verständnis der Domäne zu entwickeln:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1477",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Explorative Interviews (n=7+): ",
          "type": "text",
        },
        {
          "text": "Halbstrukturierte Gespräche mit Vertriebspersonen, die Enterprise SaaS mit sechsstelligen ACVs verkaufen. Durchgehen konkreter Deal-Verläufe, Identifikation von Schmerzpunkten, Aufgabentypen und Zeitfressern.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1482",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Literaturrecherche: ",
          "type": "text",
        },
        {
          "text": "Systematische Aufarbeitung von Sales-Methodik-Literatur (MEDDIC, SPIN, Challenger), KI-in-Sales-Forschung und Design Science Research.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1487",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Eigene Domänenerfahrung: ",
          "type": "text",
        },
        {
          "text": "Reflexion eigener Erfahrungen im Enterprise SaaS Umfeld als zusätzliche Datenquelle.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1492",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "marks": [
            {
              "type": "bold",
            },
          ],
          "text": "Shadowing (optional): ",
          "type": "text",
        },
        {
          "text": "Begleitung von Vertriebspersonen in ihrem Arbeitsalltag zur Beobachtung tatsächlicher Workflows.",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1493",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1498",
        "propsJson": "{"styleId":"berschrift3"}",
        "styleId": "berschrift3",
      },
      "content": [
        {
          "text": "Phase 2: Synthese & Strukturierung",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1502",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Die Erkenntnisse aus Phase 1 werden strukturiert und verdichtet:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1505",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Erstellung einer Mindmap aller identifizierten Aufgabentypen",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1508",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Kategorisierung in die drei Hauptbereiche: Vertragliches, Mehrwert-Argumentation, Customer Success",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1511",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Erste Einordnung der Use Cases in den Verifikationsquadranten",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1514",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Ableitung von Requirements und Hypothesen für erste Prototypen",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1515",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1520",
        "propsJson": "{"styleId":"berschrift3"}",
        "styleId": "berschrift3",
      },
      "content": [
        {
          "text": "Phase 3: Hypothesenbildung & Prototyping",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1523",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Basierend auf den Erkenntnissen werden Software-Artefakte erstellt:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1526",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Mockups und Wireframes für verschiedene Interface-Ansätze",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1529",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Funktionierende Prototypen für ausgewählte Use Cases",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1532",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Insgesamt vier Iterationsversionen, die zunehmend konvergieren",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1533",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1538",
        "propsJson": "{"styleId":"berschrift3"}",
        "styleId": "berschrift3",
      },
      "content": [
        {
          "text": "Phase 4: Evaluation & Iteration",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1541",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Jeder Prototyp wird evaluiert durch:",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1544",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Evaluierungsinterviews mit den ursprünglichen Interviewpartnern",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1547",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Praktischen Einsatz der Prototypen in realen Szenarien",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1550",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Feedback-Analyse und Ableitung von Learnings",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1553",
        "propsJson": "{"styleId":"Listenabsatz","numbering":{"numId":2,"ilvl":0},"spacing":{"after":100,"line":300,"lineRule":"auto"},"opaqueProps":[{"tag":"w:numPr","attrs":{},"subtree":[{"w:ilvl":[],":@":{"@_w:val":"0"}},{"w:numId":[],":@":{"@_w:val":"2"}}],"rawAttrs":{}}]}",
        "styleId": "Listenabsatz",
      },
      "content": [
        {
          "text": "Rückbezug auf den Quadranten: Bestätigt sich die Einordnung?",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1554",
        "propsJson": "{"spacing":{"after":100}}",
        "styleId": null,
      },
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1559",
        "propsJson": "{"styleId":"berschrift2"}",
        "styleId": "berschrift2",
      },
      "content": [
        {
          "text": "4.3  Zwei-Ebenen-Iteration",
          "type": "text",
        },
      ],
      "type": "paragraph",
    },
    {
      "attrs": {
        "alignment": null,
        "paragraphId": "n-1562",
        "propsJson": "{"spacing":{"after":200,"line":320,"lineRule":"auto"}}",
        "styleId": null,
      },
      "content": [
        {
          "text": "Ein zentrales Merkmal des Vorgehens ist die Iteration auf zwei Ebenen:",
