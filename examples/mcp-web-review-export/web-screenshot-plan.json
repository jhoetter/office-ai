{
  "schema": "office-ai/example-screenshot-plan@1",
  "baseUrl": "http://localhost:3100",
  "outputDir": "examples/_generated/mcp-web-review-export/screenshots",
  "targets": [
    {
      "name": "session-review",
      "path": "/sessions/${documentId}",
      "output": "session-review.png",
      "waitFor": "networkidle",
      "whatToInspect": [
